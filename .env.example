# Copy to `.env` and fill in. Never commit `.env`.

# ---------------------------------------------------------------- Discord (required)
# Bot token from https://discord.com/developers/applications -> your app -> Bot -> Reset Token
DISCORD_BOT_TOKEN=
# Channel for "player connected" messages (Developer Mode -> right click channel -> Copy Channel ID)
DISCORD_CHANNEL_ID=
# Optional but recommended: your server (guild) ID. Slash commands then appear immediately;
# without it they are registered globally, which can take up to an hour.
DISCORD_GUILD_ID=

# ---------------------------------------------------------------- Permissions
# Administrators may always manage players. Additionally allow these roles / users (comma separated IDs).
ADMIN_ROLE_IDS=
ADMIN_USER_IDS=
# true: everyone may use /player list and /player status; false: only managers.
PUBLIC_READ_COMMANDS=true

# ---------------------------------------------------------------- status.tw
# The public endpoints used by this bot work without a token. If you create a token in the
# status.tw dashboard it is sent as `Authorization: Bearer <token>`.
STATUS_TW_API_KEY=
STATUS_TW_BASE_URL=https://api.status.tw
# Documented limit: 100 requests / 60 s per IP. The bot never sends more than this budget per minute.
API_REQUEST_BUDGET_PER_MINUTE=60
API_TIMEOUT_SECONDS=15
API_MAX_RETRIES=2

# ---------------------------------------------------------------- Monitoring
POLL_INTERVAL_SECONDS=60
# auto       = one small request per player while it fits the budget, else one bulk request (~5 MB)
# per_player = always GET /player/name/{name}
# bulk       = always GET /player/list
POLL_STRATEGY=auto
# What happens with players that are already online when the bot starts:
# baseline = never notify on the first check after start (default)
# resume   = notify only if the stored state was "offline" before the restart
# notify   = notify every online player whose current session was not announced yet
STARTUP_STRATEGY=baseline
# Consecutive "offline" results before a player counts as offline (debounces server switches).
OFFLINE_CONFIRMATIONS=2
# Minimum seconds between two notifications for the same player (0 = off).
NOTIFY_COOLDOWN_SECONDS=0
# Minimum seconds between two messages to the channel.
NOTIFY_MIN_INTERVAL_SECONDS=1

# ---------------------------------------------------------------- Message layout
EMBED_COLOR=#701A75
# Link targets. These routes exist on the status.tw website but are NOT part of the documented
# API (https://api.status.tw/docs). Leave empty to show names without links.
PLAYER_PROFILE_URL_TEMPLATE=https://status.tw/players/{name}
SERVER_URL_TEMPLATE=https://status.tw/servers/{ip}/{port}

# ---------------------------------------------------------------- Runtime
LOG_LEVEL=INFO
# Set by compose.yaml inside the container; for local runs:
DATABASE_PATH=data/bot.sqlite3
HEARTBEAT_FILE=
